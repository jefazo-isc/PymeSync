/* Tema Corporativo Oficial PymeSync (Basado en logo_horizontal_clean.png) */
QWidget {
    font-family: "Plus Jakarta Sans", "Segoe UI", system-ui, sans-serif;
    font-size: 14px;
    color: #1e293b;
}

QMainWindow, #mainContent, #pageRoot {
    background: #f1f5f9;
}

#sidebar {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #072448,
        stop: 0.55 #0a3161,
        stop: 1 #061d3b
    );
    border-right: 1px solid #0e498c;
}

#sidebarBrandCard {
    background: #ffffff;
    border: 2px solid #14b6c4;
    border-radius: 13px;
}

#sidebarButton {
    background: transparent;
    color: #cbd5e1;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 11px 14px;
    text-align: left;
    font-weight: 600;
    font-size: 13.5px;
}

#sidebarButton:hover {
    background: rgba(20, 182, 196, 0.14);
    color: #ffffff;
    border: 1px solid rgba(20, 182, 196, 0.30);
}

#sidebarButton:checked {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0e498c,
        stop: 1 #14b6c4
    );
    color: #ffffff;
    border: 1px solid #5eead4;
    font-weight: 800;
}

#primaryButton {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #0e498c,
        stop: 1 #14b6c4
    );
    color: #ffffff;
    border: none;
}

#secondaryButton {
    background: #ffffff;
    color: #0e498c;
    border: 1.5px solid #0e498c;
}
